<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Always dark and without action bar: the app is a full-screen car dashboard. -->
    <style name="Theme.OBDUSBToTCPBridge" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/status_ok</item>
        <item name="colorPrimaryVariant">@color/screen_background</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color (switches). -->
        <item name="colorSecondary">@color/status_ok</item>
        <item name="colorSecondaryVariant">@color/status_ok</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
    </style>
    <style name="Theme.Transparent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
