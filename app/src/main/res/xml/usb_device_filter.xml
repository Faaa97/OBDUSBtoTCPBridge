<?xml version="1.0" encoding="utf-8"?>
<!-- USB serial chips used by ELM327 USB adapters (D-016). Matching on the vendor only covers every
     product of that chip maker. A non-OBD device with one of these chips (e.g. a CH340 TPMS module)
     also launches LaunchServiceActivity: harmless, the service is already running or probes it with ATZ. -->
<resources>
    <usb-device vendor-id="1027" />  <!-- 0x0403 FTDI -->
    <usb-device vendor-id="1659" />  <!-- 0x067B Prolific PL2303 -->
    <usb-device vendor-id="4292" />  <!-- 0x10C4 Silicon Labs CP210x -->
    <usb-device vendor-id="6790" />  <!-- 0x1A86 WCH CH340/CH341 -->
    <usb-device vendor-id="17224" /> <!-- 0x4348 WCH CH340 (older id) -->
</resources>
